# 공개 배포용 설정 예시. 실제 값은 이 파일에 쓰지 말고
#   - Streamlit Community Cloud: 앱 → Settings → Secrets 에 붙여 넣기
#   - 내 PC에서 공개 모드로 시험할 때만: 이 파일을 .streamlit/secrets.toml 로 복사 (.gitignore 에 있어 저장소에 안 올라감)
# 이 설정이 없으면 앱은 예전처럼 로컬 모드(SQLite + data/uploads, 로그인 없음)로 동작한다.

# Supabase → Project Settings → API (또는 Data API)
SUPABASE_URL = "https://abcd1234.supabase.co"
# anon public 키(eyJ... 로 시작) 또는 publishable 키(sb_publishable_ 로 시작).
# service_role / secret 키(sb_secret_)는 모든 사용자 데이터에 접근할 수 있으므로 절대 넣지 않는다 (넣으면 앱이 멈추고 안내함).
SUPABASE_KEY = "sb_publishable_xxxxxxxxxxxxxxxx"

# (선택) 가상 착용 Hugging Face ZeroGPU Space 페이지 주소. 없으면 가상 착용 버튼이 숨겨진다.
TRYON_SPACE_URL = "https://huggingface.co/spaces/아이디/ai-closet-tryon"

# (선택) 설치 없는 웹 체험판 주소 (GitHub Pages). 없으면 사이드바 링크가 숨겨진다.
WEB_TRIAL_URL = "https://kds020902.github.io/AI_capstone/"
